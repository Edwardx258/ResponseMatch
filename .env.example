# Copy to .env (never commit it) or export these in your shell.

# claude | deepseek | heuristic (offline keyword baselines, no API calls)
RESPONSEMATCH_BACKEND=deepseek
# leave empty for the backend's default: deepseek-v4.1-flash / claude-opus-5-5
RESPONSEMATCH_MODEL=

# Claude: an API key, or run `ant auth login` instead
ANTHROPIC_API_KEY=
# DeepSeek (OpenAI-compatible API)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# hash (offline) | default (Chroma's all-MiniLM-L6-v2, downloads on first use)
RESPONSEMATCH_EMBEDDER=hash
RESPONSEMATCH_CHROMA=.chroma
RESPONSEMATCH_HANDBOOKS=data/sample/handbook
RESPONSEMATCH_VOLUNTEERS=data/sample/volunteers.json

# dual_track | weighted | llm_only | rule_only
RESPONSEMATCH_MODE=dual_track
RESPONSEMATCH_RULE_WEIGHT=0.5
RESPONSEMATCH_RULE_MIN=0.35
RESPONSEMATCH_LLM_MIN=0.5
